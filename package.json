{
  "name": "@mirek/prelude",
  "private": true,
  "version": "1.0.0",
  "description": "pnpm workspace of small, focused TypeScript utility packages published under the @prelude/* scope.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "oxlint --type-aware packages",
    "typecheck": "node scripts/typecheck.mjs",
    "test:check": "node scripts/check-tests.mjs",
    "test:r": "pnpm -r test",
    "test": "tsx --test \"packages/*/src/**/*.test.ts\"",
    "test:scripts": "node --test scripts/*.test.mjs",
    "build": "node scripts/build.mjs",
    "manifests:check": "node scripts/normalize-package-manifests.mjs --check",
    "manifests:write": "node scripts/normalize-package-manifests.mjs --write",
    "release-hooks:check": "node scripts/normalize-release-hooks.mjs --check",
    "release-hooks:write": "node scripts/normalize-release-hooks.mjs --write",
    "makefiles:check": "node scripts/check-makefiles.mjs",
    "release:plan": "node scripts/release-plan.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:write": "node scripts/check-docs.mjs --write",
    "verify": "pnpm manifests:check && pnpm release-hooks:check && pnpm makefiles:check && pnpm docs:check && pnpm test:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:scripts && pnpm build && pnpm pack:check"
  },
  "keywords": [
    "prelude",
    "typescript",
    "utilities",
    "monorepo"
  ],
  "author": "Mirek Rusin (https://github.com/mirek)",
  "license": "CC0-1.0",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@swc/core": "^1.15.24",
    "@types/node": "^22.19.0",
    "oxlint": "^1.60.0",
    "oxlint-tsgolint": "^0.20.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
