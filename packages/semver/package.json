{
  "name": "@prelude/semver",
  "version": "3.0.1",
  "description": "Semantic Versioning 2.0 parsing, comparison and precedence ordering.",
  "type": "module",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "pnpm tsx --test \"src/**/*.test.ts\" --coverage",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "keywords": [
    "prelude",
    "std",
    "lib",
    "stdlib",
    "library"
  ],
  "author": "Mirek Rusin (https://github.com/mirek)",
  "license": "CC0-1.0",
  "module": "./mjs/index.js",
  "exports": {
    ".": {
      "types": "./mjs/index.d.ts",
      "import": "./mjs/index.js"
    },
    "./*.js": {
      "types": "./mjs/*.d.ts",
      "import": "./mjs/*.js"
    }
  },
  "dependencies": {
    "@prelude/cmp": "workspace:*",
    "@prelude/function": "workspace:*"
  },
  "devDependencies": {
    "@prelude/tsconfig": "workspace:*"
  },
  "files": [
    "mjs",
    "Readme.md",
    "README.md",
    "License.md",
    "LICENSE"
  ],
  "types": "./mjs/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirek/prelude.git",
    "directory": "packages/semver"
  },
  "homepage": "https://github.com/mirek/prelude/tree/main/packages/semver#readme",
  "bugs": "https://github.com/mirek/prelude/issues"
}
