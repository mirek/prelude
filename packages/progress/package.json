{
  "name": "@prelude/progress",
  "version": "1.0.1",
  "description": "Terminal progress display for Node.js: multi-worker progress bars, spinners and percentages on stdout.",
  "type": "module",
  "files": [
    "mjs",
    "Readme.md",
    "README.md",
    "License.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "make test",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "keywords": [
    "prelude",
    "std",
    "lib",
    "stdlib",
    "library",
    "progress",
    "tui",
    "cli",
    "multi",
    "bar",
    "spinner",
    "ansi"
  ],
  "author": "Mirek Rusin (https://github.com/mirek)",
  "license": "CC0-1.0",
  "module": "./mjs/index.js",
  "exports": {
    ".": {
      "types": "./mjs/index.d.ts",
      "import": "./mjs/index.js"
    },
    "./*.js": {
      "types": "./mjs/*.d.ts",
      "import": "./mjs/*.js"
    }
  },
  "devDependencies": {
    "@prelude/tsconfig": "workspace:*"
  },
  "types": "./mjs/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirek/prelude.git",
    "directory": "packages/progress"
  },
  "homepage": "https://github.com/mirek/prelude/tree/main/packages/progress#readme",
  "bugs": "https://github.com/mirek/prelude/issues"
}
