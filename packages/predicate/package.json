{
  "name": "@prelude/predicate",
  "version": "1.0.0",
  "description": "Type-guard combinators for primitives, objects, arrays, tuples, records and unions; built on @prelude/validation.",
  "type": "module",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "make test",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "keywords": [
    "prelude",
    "std",
    "lib",
    "stdlib",
    "library",
    "cmp",
    "compare",
    "sort"
  ],
  "author": "Mirek Rusin (https://github.com/mirek)",
  "license": "CC0-1.0",
  "devDependencies": {
    "@prelude/tsconfig": "workspace:*"
  },
  "module": "./mjs/index.js",
  "exports": {
    ".": {
      "types": "./mjs/index.d.ts",
      "import": "./mjs/index.js"
    },
    "./*.js": {
      "types": "./mjs/*.d.ts",
      "import": "./mjs/*.js"
    }
  },
  "files": [
    "mjs",
    "Readme.md",
    "README.md",
    "License.md",
    "LICENSE"
  ],
  "types": "./mjs/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirek/prelude.git",
    "directory": "packages/predicate"
  },
  "homepage": "https://github.com/mirek/prelude/tree/main/packages/predicate#readme",
  "bugs": "https://github.com/mirek/prelude/issues",
  "dependencies": {
    "@prelude/validation": "workspace:*"
  }
}
