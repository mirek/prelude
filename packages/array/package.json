{
  "name": "@prelude/array",
  "version": "4.0.0",
  "description": "Array utilities: safe indexing, sampling and shuffling, sorting and searching, grouping, swap-delete and vector helpers.",
  "type": "module",
  "scripts": {
    "test": "pnpm tsx --test \"src/**/*.test.ts\"",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "keywords": [
    "prelude",
    "std",
    "lib",
    "stdlib",
    "library",
    "cmp",
    "compare",
    "sort"
  ],
  "author": "Mirek Rusin (https://github.com/mirek)",
  "license": "CC0-1.0",
  "dependencies": {
    "@prelude/cmp": "workspace:*"
  },
  "devDependencies": {
    "@prelude/tsconfig": "workspace:*"
  },
  "module": "./mjs/index.js",
  "exports": {
    ".": {
      "types": "./mjs/index.d.ts",
      "import": "./mjs/index.js"
    },
    "./*.js": {
      "types": "./mjs/*.d.ts",
      "import": "./mjs/*.js"
    }
  },
  "files": [
    "mjs",
    "Readme.md",
    "README.md",
    "License.md",
    "LICENSE"
  ],
  "types": "./mjs/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirek/prelude.git",
    "directory": "packages/array"
  },
  "homepage": "https://github.com/mirek/prelude/tree/main/packages/array#readme",
  "bugs": "https://github.com/mirek/prelude/issues"
}
