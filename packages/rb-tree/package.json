{
  "name": "@prelude/rb-tree",
  "version": "0.3.0",
  "description": "Persistent red-black tree with duplicate counts, range counting and Bag/Map wrappers, with exported invariant checks.",
  "type": "module",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "make test",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "keywords": [
    "prelude",
    "std",
    "lib",
    "stdlib",
    "library",
    "cmp",
    "compare",
    "sort"
  ],
  "author": "Mirek Rusin (https://github.com/mirek)",
  "license": "CC0-1.0",
  "devDependencies": {
    "@prelude/array": "workspace:*",
    "@prelude/tsconfig": "workspace:*"
  },
  "dependencies": {
    "@prelude/cmp": "workspace:*"
  },
  "module": "./mjs/index.js",
  "exports": {
    ".": {
      "types": "./mjs/index.d.ts",
      "import": "./mjs/index.js"
    },
    "./bag": {
      "types": "./mjs/bag.d.ts",
      "import": "./mjs/bag.js"
    },
    "./map": {
      "types": "./mjs/map.d.ts",
      "import": "./mjs/map.js"
    }
  },
  "files": [
    "mjs",
    "Readme.md",
    "README.md",
    "License.md",
    "LICENSE"
  ],
  "types": "./mjs/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirek/prelude.git",
    "directory": "packages/rb-tree"
  },
  "homepage": "https://github.com/mirek/prelude/tree/main/packages/rb-tree#readme",
  "bugs": "https://github.com/mirek/prelude/issues"
}
