{
  "name": "@prelude/parser",
  "version": "8.0.0",
  "description": "Parser combinators over string readers with location-aware failures, plus an RFC 8259 JSON grammar.",
  "type": "module",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "pnpm oxlint --type-aware src && pnpm tsx --test \"src/**/*.test.ts\" --coverage",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "keywords": [
    "prelude",
    "std",
    "lib",
    "stdlib",
    "library",
    "parse",
    "parser",
    "combinators",
    "functional"
  ],
  "author": "Mirek Rusin (https://github.com/mirek)",
  "license": "CC0-1.0",
  "devDependencies": {
    "@prelude/refute": "workspace:*",
    "@prelude/tsconfig": "workspace:*"
  },
  "module": "./mjs/index.js",
  "exports": {
    ".": {
      "types": "./mjs/index.d.ts",
      "import": "./mjs/index.js"
    },
    "./*.js": {
      "types": "./mjs/*.d.ts",
      "import": "./mjs/*.js"
    }
  },
  "dependencies": {
    "@prelude/radix-trie": "workspace:*"
  },
  "files": [
    "mjs",
    "Readme.md",
    "README.md",
    "License.md",
    "LICENSE"
  ],
  "types": "./mjs/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirek/prelude.git",
    "directory": "packages/parser"
  },
  "homepage": "https://github.com/mirek/prelude/tree/main/packages/parser#readme",
  "bugs": "https://github.com/mirek/prelude/issues"
}
