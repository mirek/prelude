{
  "name": "@prelude/async-generator",
  "version": "2.0.0",
  "description": "Composable async iterable transforms: map, filter, batch, window, buffered and concurrent processing with backpressure.",
  "type": "module",
  "module": "./mjs/index.js",
  "exports": {
    ".": {
      "types": "./mjs/index.d.ts",
      "import": "./mjs/index.js"
    },
    "./*.js": {
      "types": "./mjs/*.d.ts",
      "import": "./mjs/*.js"
    }
  },
  "scripts": {
    "test": "pnpm oxlint --type-aware src && pnpm tsx --test \"src/**/*.test.ts\" --coverage",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "keywords": [
    "prelude",
    "std",
    "lib",
    "stdlib",
    "library",
    "cmp",
    "compare",
    "sort"
  ],
  "author": "Mirek Rusin (https://github.com/mirek)",
  "license": "CC0-1.0",
  "dependencies": {
    "@prelude/channel": "workspace:*",
    "@prelude/emitter": "workspace:*"
  },
  "devDependencies": {
    "@prelude/tsconfig": "workspace:*"
  },
  "files": [
    "mjs",
    "Readme.md",
    "README.md",
    "License.md",
    "LICENSE"
  ],
  "types": "./mjs/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirek/prelude.git",
    "directory": "packages/async-generator"
  },
  "homepage": "https://github.com/mirek/prelude/tree/main/packages/async-generator#readme",
  "bugs": "https://github.com/mirek/prelude/issues"
}
