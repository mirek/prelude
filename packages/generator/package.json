{
  "name": "@prelude/generator",
  "version": "9.0.0",
  "description": "Iterable and generator utilities: lazy map, filter, flatMap, batch, group, permutations, primes and other transforms over sync iterables.",
  "type": "module",
  "module": "./mjs/index.js",
  "exports": {
    ".": {
      "types": "./mjs/index.d.ts",
      "import": "./mjs/index.js"
    },
    "./*.js": {
      "types": "./mjs/*.d.ts",
      "import": "./mjs/*.js"
    }
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "pnpm tsx --test \"src/**/*.test.ts\" --coverage",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "keywords": [
    "prelude",
    "std",
    "lib",
    "stdlib",
    "library",
    "generators",
    "functional",
    "combinators"
  ],
  "author": "Mirek Rusin (https://github.com/mirek)",
  "license": "CC0-1.0",
  "devDependencies": {
    "@swc-node/register": "1.11.1",
    "@prelude/tsconfig": "workspace:*"
  },
  "dependencies": {
    "@prelude/cmp": "workspace:*"
  },
  "files": [
    "mjs",
    "Readme.md",
    "README.md",
    "License.md",
    "LICENSE"
  ],
  "types": "./mjs/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirek/prelude.git",
    "directory": "packages/generator"
  },
  "homepage": "https://github.com/mirek/prelude/tree/main/packages/generator#readme",
  "bugs": "https://github.com/mirek/prelude/issues"
}
