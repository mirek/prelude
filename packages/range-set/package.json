{
  "name": "@prelude/range-set",
  "version": "1.0.1",
  "description": "Sets of value-carrying ranges over ordered keys with union, intersection and difference under pluggable value merges.",
  "type": "module",
  "module": "./mjs/index.js",
  "scripts": {
    "test": "NODE_OPTIONS='--no-warnings --experimental-vm-modules' pnpm tsx --test \"src/**/*.test.ts\"",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "keywords": [
    "prelude",
    "std",
    "lib",
    "stdlib",
    "library",
    "esm",
    "range",
    "set",
    "interval",
    "interval-set",
    "union",
    "intersection",
    "difference",
    "merge"
  ],
  "author": "Mirek Rusin (https://github.com/mirek)",
  "license": "CC0-1.0",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/types": "^7.29.0",
    "@prelude/testing": "workspace:*",
    "@prelude/tsconfig": "workspace:*",
    "@types/babel__core": "^7.20.5"
  },
  "exports": {
    ".": {
      "types": "./mjs/index.d.ts",
      "import": "./mjs/index.js"
    },
    "./*.js": {
      "types": "./mjs/*.d.ts",
      "import": "./mjs/*.js"
    },
    "./*": {
      "types": "./mjs/*.d.ts",
      "import": "./mjs/*.js"
    }
  },
  "packageManager": "pnpm@10.12.1",
  "peerDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/types": "^7.27.0"
  },
  "files": [
    "mjs",
    "Readme.md",
    "README.md",
    "License.md",
    "LICENSE"
  ],
  "types": "./mjs/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirek/prelude.git",
    "directory": "packages/range-set"
  },
  "homepage": "https://github.com/mirek/prelude/tree/main/packages/range-set#readme",
  "bugs": "https://github.com/mirek/prelude/issues"
}
