{
  "name": "@prelude/sorted-array",
  "version": "1.0.1",
  "description": "Arrays kept sorted by a comparator with binary search, insert, insert-ignore and upsert.",
  "type": "module",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "make test",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "keywords": [
    "prelude",
    "std",
    "lib",
    "stdlib",
    "library",
    "cmp",
    "compare",
    "sort",
    "sorted",
    "array"
  ],
  "author": "Mirek Rusin (https://github.com/mirek)",
  "license": "CC0-1.0",
  "dependencies": {
    "@prelude/cmp": "workspace:*"
  },
  "devDependencies": {
    "@prelude/testing": "workspace:*",
    "@prelude/tsconfig": "workspace:*"
  },
  "module": "./mjs/index.js",
  "exports": {
    ".": {
      "types": "./mjs/index.d.ts",
      "import": "./mjs/index.js"
    },
    "./*.js": {
      "types": "./mjs/*.d.ts",
      "import": "./mjs/*.js"
    }
  },
  "files": [
    "mjs",
    "Readme.md",
    "README.md",
    "License.md",
    "LICENSE"
  ],
  "types": "./mjs/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirek/prelude.git",
    "directory": "packages/sorted-array"
  },
  "homepage": "https://github.com/mirek/prelude/tree/main/packages/sorted-array#readme",
  "bugs": "https://github.com/mirek/prelude/issues"
}
