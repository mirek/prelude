{
  "name": "@prelude/xml",
  "version": "1.0.1",
  "description": "XML 1.0 parser with namespace processing, precise error locations and JSON conversion helpers; no DTD processing or external resources.",
  "type": "module",
  "scripts": {
    "test": "make test",
    "build": "make build",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "keywords": [
    "prelude",
    "std",
    "lib",
    "stdlib",
    "library",
    "xml",
    "json"
  ],
  "author": "Mirek Rusin (https://github.com/mirek)",
  "license": "CC0-1.0",
  "module": "./mjs/index.js",
  "exports": {
    ".": {
      "types": "./mjs/index.d.ts",
      "import": "./mjs/index.js"
    },
    "./*.js": {
      "types": "./mjs/*.d.ts",
      "import": "./mjs/*.js"
    }
  },
  "devDependencies": {
    "@prelude/testing": "workspace:*",
    "@prelude/tsconfig": "workspace:*"
  },
  "files": [
    "mjs",
    "Readme.md",
    "README.md",
    "License.md",
    "LICENSE"
  ],
  "types": "./mjs/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirek/prelude.git",
    "directory": "packages/xml"
  },
  "homepage": "https://github.com/mirek/prelude/tree/main/packages/xml#readme",
  "bugs": "https://github.com/mirek/prelude/issues"
}
