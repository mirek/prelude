{
  "name": "@prelude/xml",
  "version": "0.0.0",
  "description": "Xml module.",
  "type": "module",
  "scripts": {
    "test": "make test",
    "build": "make build",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "keywords": [
    "prelude",
    "std",
    "lib",
    "stdlib",
    "library",
    "xml",
    "json"
  ],
  "author": "Mirek Rusin (https://github.com/mirek)",
  "license": "CC0-1.0",
  "module": "./mjs/index.js",
  "exports": {
    ".": {
      "types": "./mjs/index.d.ts",
      "import": "./mjs/index.js"
    },
    "./*.js": {
      "types": "./mjs/*.d.ts",
      "import": "./mjs/*.js"
    }
  },
  "dependencies": {
    "@prelude/parser": "workspace:*"
  },
  "devDependencies": {
    "@prelude/tsconfig": "workspace:*"
  },
  "files": [
    "mjs",
    "Readme.md",
    "README.md",
    "License.md",
    "LICENSE"
  ],
  "types": "./mjs/index.d.ts"
}
