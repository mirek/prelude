{
  "name": "@prelude/log",
  "version": "2.0.1",
  "description": "Lightweight logger with severity levels, namespaces, pluggable targets and environment-variable level control.",
  "type": "module",
  "scripts": {
    "test": "make test",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "module": "./mjs/index.js",
  "exports": {
    ".": {
      "types": "./mjs/index.d.ts",
      "import": "./mjs/index.js"
    },
    "./*.js": {
      "types": "./mjs/*.d.ts",
      "import": "./mjs/*.js"
    }
  },
  "keywords": [
    "prelude",
    "std",
    "lib",
    "stdlib",
    "library",
    "log",
    "logger",
    "bunyan",
    "winston"
  ],
  "author": "Mirek Rusin (https://github.com/mirek)",
  "license": "CC0-1.0",
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "7.29.0",
    "@babel/preset-env": "7.29.2",
    "@babel/preset-typescript": "7.28.5",
    "@prelude/tsconfig": "workspace:*"
  },
  "files": [
    "mjs",
    "Readme.md",
    "README.md",
    "License.md",
    "LICENSE"
  ],
  "types": "./mjs/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirek/prelude.git",
    "directory": "packages/log"
  },
  "homepage": "https://github.com/mirek/prelude/tree/main/packages/log#readme",
  "bugs": "https://github.com/mirek/prelude/issues"
}
