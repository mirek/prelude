{
  "name": "@prelude/jsonrpc",
  "version": "0.1.0",
  "description": "Jsonrpc module.",
  "type": "module",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "pnpm tsx --test \"src/**/*.test.ts\" --coverage",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "keywords": [
    "prelude",
    "std",
    "lib",
    "stdlib",
    "library",
    "cmp",
    "compare",
    "sort"
  ],
  "author": "Mirek Rusin (https://github.com/mirek)",
  "license": "CC0-1.0",
  "dependencies": {
    "@prelude/err": "workspace:*",
    "@prelude/predicate": "workspace:*"
  },
  "devDependencies": {
    "@prelude/tsconfig": "workspace:*"
  },
  "module": "./mjs/index.js",
  "exports": {
    ".": {
      "types": "./mjs/index.d.ts",
      "import": "./mjs/index.js"
    },
    "./*.js": {
      "types": "./mjs/*.d.ts",
      "import": "./mjs/*.js"
    }
  },
  "files": [
    "mjs",
    "Readme.md",
    "README.md",
    "License.md",
    "LICENSE"
  ],
  "types": "./mjs/index.d.ts",
  "engines": {
    "node": ">=22"
  }
}
