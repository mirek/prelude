{
  "name": "@prelude/serial-queue",
  "version": "0.1.0",
  "description": "Promise-returning serial task queue: pushed work runs one at a time, in order, with bulk rejection.",
  "type": "module",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "make test",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "keywords": [
    "prelude",
    "std",
    "lib",
    "stdlib",
    "library"
  ],
  "author": "Mirek Rusin (https://github.com/mirek)",
  "license": "CC0-1.0",
  "devDependencies": {
    "@prelude/array": "workspace:*",
    "@prelude/tsconfig": "workspace:*"
  },
  "module": "./mjs/index.js",
  "exports": {
    ".": {
      "types": "./mjs/index.d.ts",
      "import": "./mjs/index.js"
    },
    "./*.js": {
      "types": "./mjs/*.d.ts",
      "import": "./mjs/*.js"
    }
  },
  "files": [
    "mjs",
    "Readme.md",
    "README.md",
    "License.md",
    "LICENSE"
  ],
  "types": "./mjs/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirek/prelude.git",
    "directory": "packages/serial-queue"
  },
  "homepage": "https://github.com/mirek/prelude/tree/main/packages/serial-queue#readme",
  "bugs": "https://github.com/mirek/prelude/issues"
}
